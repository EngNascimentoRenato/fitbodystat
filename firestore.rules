rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function accountIsActive() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != "suspended";
    }

    function isAdmin() {
      return accountIsActive() && currentRole() == "admin";
    }

    function isProfessional() {
      return accountIsActive() && currentRole() == "professional";
    }

    function hasVerifiedEmail() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function ownProfessionalRegistration() {
      return /databases/$(database)/documents/professionalRegistrations/$(request.auth.token.email.lower());
    }

    function activatesPreauthorizedProfessional(userId) {
      return accountIsActive()
        && request.auth.uid == userId
        && hasVerifiedEmail()
        && resource.data.role == "user"
        && request.resource.data.role == "professional"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["role", "updatedAt"])
        && exists(ownProfessionalRegistration())
        && get(ownProfessionalRegistration()).data.status in ["awaiting_registration", "awaiting_validation"]
        && get(ownProfessionalRegistration()).data.emailLower == request.auth.token.email.lower()
        && getAfter(ownProfessionalRegistration()).data.status == "active"
        && getAfter(ownProfessionalRegistration()).data.userId == request.auth.uid;
    }

    function professionalLink(patientId) {
      return /databases/$(database)/documents/careLinks/$(request.auth.uid + "_" + patientId);
    }

    function activeProfessionalLink(patientId) {
      return isProfessional()
        && exists(professionalLink(patientId))
        && get(professionalLink(patientId)).data.status == "active";
    }

    function activeRelationship(otherUserId) {
      let firstLink = /databases/$(database)/documents/careLinks/$(request.auth.uid + "_" + otherUserId);
      let secondLink = /databases/$(database)/documents/careLinks/$(otherUserId + "_" + request.auth.uid);
      return accountIsActive()
        && ((exists(firstLink) && get(firstLink).data.status == "active")
        || (exists(secondLink) && get(secondLink).data.status == "active"));
    }

    function canReadHealthData(ownerId) {
      return accountIsActive()
        && (request.auth.uid == ownerId
          || (activeProfessionalLink(ownerId)
            && get(professionalLink(ownerId)).data.permissions.viewData == true));
    }

    function canEditHealthData(ownerId) {
      return accountIsActive()
        && (request.auth.uid == ownerId
          || (activeProfessionalLink(ownerId)
            && get(professionalLink(ownerId)).data.permissions.editData == true));
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.role == "user"
        && request.resource.data.status == "active";

      allow get: if signedIn()
        && (request.auth.uid == userId || isAdmin() || activeRelationship(userId));

      allow list: if isAdmin();

      allow update: if isAdmin()
        || activatesPreauthorizedProfessional(userId)
        || (accountIsActive()
          && request.auth.uid == userId
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.role == resource.data.role
          && (request.resource.data.status == resource.data.status
            || (!("status" in resource.data) && request.resource.data.status == "active")));

      allow delete: if isAdmin();

      match /measurements/{measurementId} {
        allow read: if canReadHealthData(userId);
        allow create, update, delete: if canEditHealthData(userId);
      }

      match /activities/{activityId} {
        allow read: if canReadHealthData(userId);
        allow create, update, delete: if canEditHealthData(userId);
      }

      match /cycles/{cycleId} {
        allow read: if canReadHealthData(userId);
        allow create, update: if canEditHealthData(userId)
          && request.resource.data.id == cycleId
          && request.resource.data.status in [
            "draft",
            "active",
            "completed",
            "abandoned",
            "expired",
            "archived"
          ];
        allow delete: if false;
      }
    }

    match /profiles/{userId} {
      allow read: if canReadHealthData(userId);
      allow create, update, delete: if canEditHealthData(userId);
    }

    match /plans/{userId} {
      allow read: if canReadHealthData(userId);
      allow create, update, delete: if canEditHealthData(userId);
    }

    match /settings/{userId} {
      allow read: if canReadHealthData(userId);
      allow create, update, delete: if canEditHealthData(userId);
    }

    match /contacts/{userId} {
      allow read: if accountIsActive()
        && (request.auth.uid == userId
          || (activeProfessionalLink(userId)
            && get(professionalLink(userId)).data.permissions.sharePhone == true)
          || (get(/databases/$(database)/documents/users/$(userId)).data.role == "professional"
            && activeRelationship(userId)));

      allow create, update: if isAdmin()
        || (accountIsActive()
          && request.auth.uid == userId
          && request.resource.data.ownerId == userId);

      allow delete: if isAdmin()
        || (accountIsActive() && request.auth.uid == userId);
    }

    match /professionalProfiles/{userId} {
      allow read: if accountIsActive()
        && (request.auth.uid == userId || isAdmin() || activeRelationship(userId));

      allow create, update: if isAdmin()
        || (accountIsActive()
          && request.auth.uid == userId
          && request.resource.data.ownerId == userId);

      allow delete: if isAdmin()
        || (accountIsActive() && request.auth.uid == userId);
    }

    match /professionalAgendas/{professionalId}/settings/{settingsId} {
      function ownsAgendaSettings() {
        return isProfessional() && request.auth.uid == professionalId;
      }

      allow read: if ownsAgendaSettings();

      allow create, update: if ownsAgendaSettings()
        && settingsId == "availability"
        && request.resource.data.professionalId == professionalId
        && request.resource.data.timeZone is string
        && request.resource.data.slotIntervalMinutes in [15, 30, 45, 60]
        && request.resource.data.weekly is map;

      allow delete: if ownsAgendaSettings();
    }

    match /professionalAgendas/{professionalId}/events/{eventId} {
      function ownsAgenda() {
        return isProfessional() && request.auth.uid == professionalId;
      }

      function validAgendaEvent() {
        return request.resource.data.keys().hasAll([
            "professionalId",
            "createdBy",
            "type",
            "title",
            "date",
            "startTime",
            "endTime",
            "durationMinutes",
            "allDay",
            "startsAt",
            "endsAt",
            "timeZone",
            "status",
            "bookingMode",
            "capacity",
            "blocksAvailability",
            "recurrence",
            "visibility"
          ])
          && request.resource.data.professionalId == professionalId
          && request.resource.data.createdBy == professionalId
          && request.resource.data.type in ["appointment", "block"]
          && request.resource.data.title is string
          && request.resource.data.date is string
          && request.resource.data.startTime is string
          && request.resource.data.endTime is string
          && request.resource.data.durationMinutes is int
          && request.resource.data.durationMinutes >= 15
          && request.resource.data.durationMinutes <= 1440
          && request.resource.data.allDay is bool
          && request.resource.data.startsAt is string
          && request.resource.data.endsAt is string
          && request.resource.data.timeZone is string
          && request.resource.data.bookingMode in ["exclusive", "group", "informational"]
          && request.resource.data.capacity is int
          && request.resource.data.capacity >= 1
          && request.resource.data.capacity <= 100
          && request.resource.data.blocksAvailability is bool
          && request.resource.data.recurrence is map
          && request.resource.data.visibility == "private"
          && ((request.resource.data.type == "block"
              && request.resource.data.status == "blocked")
            || (request.resource.data.type == "appointment"
              && request.resource.data.status in [
                "scheduled",
                "confirmed",
                "completed",
                "cancelled",
                "no-show"
              ]));
      }

      allow read: if ownsAgenda();

      allow create: if ownsAgenda() && validAgendaEvent();

      allow update: if ownsAgenda()
        && resource.data.professionalId == professionalId
        && resource.data.createdBy == professionalId
        && request.resource.data.type == resource.data.type
        && validAgendaEvent();

      allow delete: if ownsAgenda();
    }

    match /professionalRegistrations/{registrationId} {
      allow read: if isAdmin()
        || (hasVerifiedEmail()
          && registrationId == request.auth.token.email.lower());

      allow create: if isAdmin();

      allow update: if isAdmin()
        || (hasVerifiedEmail()
          && registrationId == request.auth.token.email.lower()
          && resource.data.emailLower == request.auth.token.email.lower()
          && resource.data.status in ["awaiting_registration", "awaiting_validation"]
          && request.resource.data.status == "active"
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.emailLower == resource.data.emailLower
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status", "userId", "activatedAt", "updatedAt"
          ]));

      allow delete: if false;
    }

    match /careInvitations/{invitationId} {
      allow create: if isProfessional()
        && request.resource.data.professionalId == request.auth.uid
        && request.resource.data.patientEmailLower is string
        && request.resource.data.patientEmailLower != request.auth.token.email.lower()
        && request.resource.data.patientId == null
        && request.resource.data.status == "pending"
        && request.resource.data.permissions.viewData == true
        && request.resource.data.permissions.editData == true
        && request.resource.data.permissions.createCycles == true
        && request.resource.data.accessBenefit.source == "professional-link"
        && request.resource.data.accessBenefit.activeWhileLinked == true;

      allow read: if isAdmin()
        || (accountIsActive() && resource.data.professionalId == request.auth.uid)
        || (accountIsActive()
          && request.auth.token.email != null
          && resource.data.patientEmailLower == request.auth.token.email.lower());

      allow update: if isAdmin()
        || (isProfessional()
          && resource.data.professionalId == request.auth.uid
          && resource.data.status == "pending"
          && request.resource.data.status == "cancelled"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"]))
        || (accountIsActive()
          && request.auth.token.email != null
          && resource.data.patientEmailLower == request.auth.token.email.lower()
          && resource.data.status == "pending"
          && request.resource.data.status in ["accepted", "rejected"]
          && request.resource.data.patientId == request.auth.uid
          && request.resource.data.professionalId == resource.data.professionalId
          && request.resource.data.patientEmailLower == resource.data.patientEmailLower
          && request.resource.data.permissions == resource.data.permissions
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status", "patientId", "patientName", "respondedAt", "updatedAt"
          ]));

      allow delete: if isAdmin();
    }

    match /careLinks/{linkId} {
      function acceptedInvitationMatchesLink() {
        let invitation = getAfter(
          /databases/$(database)/documents/careInvitations/$(request.resource.data.invitationId)
        );
        return invitation.data.status == "accepted"
          && invitation.data.patientId == request.auth.uid
          && invitation.data.professionalId == request.resource.data.professionalId
          && request.resource.data.patientId == request.auth.uid
          && linkId == request.resource.data.professionalId + "_" + request.auth.uid
          && request.resource.data.status == "active"
          && request.resource.data.originInvitationId == request.resource.data.invitationId
          && request.resource.data.permissions.viewData == invitation.data.permissions.viewData
          && request.resource.data.permissions.editData == invitation.data.permissions.editData
          && request.resource.data.permissions.createCycles == true
          && request.resource.data.permissions.sharePhone is bool
          && request.resource.data.accessBenefit.source == "professional-link"
          && request.resource.data.accessBenefit.activeWhileLinked == true;
      }

      allow read: if isAdmin()
        || (accountIsActive()
          && (resource.data.professionalId == request.auth.uid
            || resource.data.patientId == request.auth.uid));

      allow create: if isAdmin()
        || (accountIsActive()
          && acceptedInvitationMatchesLink());

      allow update: if isAdmin()
        || (accountIsActive()
          && resource.data.status == "revoked"
          && acceptedInvitationMatchesLink()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "invitationId", "status", "permissions", "originInvitationId",
            "accessBenefit", "createdAt", "updatedAt", "revokedBy", "revokedAt"
          ]))
        || (accountIsActive()
          && resource.data.patientId == request.auth.uid
          && resource.data.status == "active"
          && request.resource.data.status == resource.data.status
          && request.resource.data.professionalId == resource.data.professionalId
          && request.resource.data.patientId == resource.data.patientId
          && request.resource.data.invitationId == resource.data.invitationId
          && request.resource.data.permissions.viewData == resource.data.permissions.viewData
          && request.resource.data.permissions.editData == resource.data.permissions.editData
          && ((!("createCycles" in resource.data.permissions)
                && request.resource.data.permissions.createCycles == true)
            || request.resource.data.permissions.createCycles == resource.data.permissions.createCycles)
          && request.resource.data.permissions.sharePhone is bool
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "permissions", "updatedAt"
          ]))
        || (accountIsActive()
          && (resource.data.professionalId == request.auth.uid
            || resource.data.patientId == request.auth.uid)
          && resource.data.status == "active"
          && request.resource.data.status == "revoked"
          && request.resource.data.professionalId == resource.data.professionalId
          && request.resource.data.patientId == resource.data.patientId
          && request.resource.data.invitationId == resource.data.invitationId
          && request.resource.data.permissions == resource.data.permissions
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status", "revokedBy", "revokedAt", "updatedAt"
          ]));

      allow delete: if isAdmin();
    }
  }
}
