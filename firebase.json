{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      ".git",
      ".git/**",
      ".firebase",
      ".firebase/**",
      ".agents",
      ".agents/**",
      ".codex",
      ".codex/**",
      "**/node_modules/**",
      "functions/**",
      "tests/**",
      "scripts/**",
      "firestore.rules",
      "README.md",
      "ESTRUTURA.md",
      "direcionamentos.txt",
      "dev-server.mjs",
      "*.log"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "/service-worker.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/manifest.webmanifest",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
